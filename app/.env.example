# Copiá este archivo a .env (git lo ignora) y poné valores reales:
#   cp .env.example .env
#
# NINGUN valor real va acá dentro: este archivo se commitea.

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_SCHEMA=tienda

# --- Auth ---
# Generá uno propio con: openssl rand -hex 64
JWT_SECRET=
# Cuantas horas vale un token antes de vencer.
JWT_HORAS=24

# --- Reglas de negocio parametrizables ---
UMBRAL_ENVIO_GRATIS=50000
COSTO_ENVIO=5000

# --- Rutas ---
UPLOADS_DIR=/app/uploads
